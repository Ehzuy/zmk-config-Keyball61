#define DEFAULT 0
#define SYM     1
#define FUN     2
#define MOUSE   3
#define SCROLL  4
#define SNIPE   5

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&nice_view_spi { cs-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>; };

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Left-cllick {
            bindings = <&mkp MB1>;
            key-positions = <28 27>;
        };

        Bootloader {
            bindings = <&bootloader>;
            key-positions = <0 1>;
            layers = <1>;
        };

        Bootload_right {
            bindings = <&bootloader>;
            key-positions = <10 11>;
            layers = <1>;
        };

        Shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <53 52>;
        };

        Right-click {
            bindings = <&mkp MB2>;
            key-positions = <26 25>;
        };

        Mouse-3 {
            bindings = <&mkp MCLK>;
            key-positions = <26 27>;
        };

        Del {
            bindings = <&kp DELETE>;
            key-positions = <54 55>;
        };

        Ctrl {
            bindings = <&kp LCTRL>;
            key-positions = <42 41>;
        };

        mouse_scroll_down {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <40 39>;
        };

        mouse_scroll_up {
            bindings = <&msc SCRL_UP>;
            key-positions = <39 38>;
        };
    };

    macros {
        square_bracket: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT_ARROW>;
            label = "NEW_MACRO";
        };

        bracket: m2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "M2";
        };

        curly_bracket: curly_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT_ARROW>;
            label = "CURLY_BRACKET";
        };

        triangle_bracket: triangle_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp GT &kp LEFT_ARROW>;
            label = "TRIANGLE_BRACKET";
        };
    };

    behaviors {
        holdtap: holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDTAP";
            bindings = <&mt>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <240>;
            hold-trigger-key-positions = <53 55>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp ESC         &kp N1        &kp N2  &kp N3  &kp N4  &kp N5                                             &kp N6         &kp N7       &kp N8           &kp N9                &kp N0          &kp EQUAL
&kp TAB         &kp Q         &kp W   &kp E   &kp R   &kp T                                              &kp Y          &kp U        &kp I            &kp O                 &kp SEMICOLON   &kp GRAVE
&kp LEFT_SHIFT  &kp A         &kp S   &kp D   &kp F   &kp G                                              &kp H          &kp J        &kp K            &kp L                 &kp P           &kp SQT
&kp LEFT_WIN    &kp Z         &kp X   &kp C   &kp V   &lt 1 ENTER  &mt LEFT_ALT BACKSPACE  &lt 1 PERIOD  &kp B          &kp N        &kp M            &kp NON_US_BACKSLASH  &kp FSLH        &kp MINUS
&kp LCTRL       &lt 1 DELETE                          &kp SPACE    &kp LCTRL               &kp LCTRL     &kp BACKSPACE  &lt 2 COMMA  &square_bracket  &bracket              &curly_bracket  &triangle_bracket
            >;
        };

        number_layer {
            bindings = <
&to 0   &kp F1  &kp F2    &kp F3        &kp F4          &kp F5                                &kp F6  &kp F7          &kp F8        &kp F9        &kp F10     &kp F11
&trans  &trans  &trans    &kp UP_ARROW  &trans          &trans                                &trans  &kp HOME        &kp UP_ARROW  &kp END       &trans      &kp F12
&trans  &trans  &kp LEFT  &kp DOWN      &kp RIGHT       &trans                                &trans  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT     &trans      &trans
&trans  &trans  &trans    &msc SCRL_UP  &msc SCRL_DOWN  &lt 1 ENTER  &kp LEFT_ALT  &trans     &trans  &trans          &trans        &trans        &trans      &trans
&trans  &trans                                          &trans       &kp LCTRL     &kp LCTRL  &trans  &kp DELETE      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_NXT  &bt BT_CLR_ALL
            >;

            label = "NUM";
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&to 0   &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT                  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &trans           &trans        &trans        &trans        &trans                       &trans          &trans         &trans            &trans                &trans                 &trans
&trans  &bt BT_CLR       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans                       &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &trans                 &trans
&trans  &trans           &trans        &trans        &trans        &trans       &trans  &trans  &kp UNDERSCORE  &kp PLUS       &trans            &trans                &trans                 &trans
&trans  &trans                                                     &trans       &trans  &trans  &trans          &trans         &trans            &trans                &trans                 &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&to 0   &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
